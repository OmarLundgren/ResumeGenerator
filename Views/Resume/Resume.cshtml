@model ResumeGenerator.Models.ResumeModel
   

@section Styles {
    <link rel="stylesheet" href="~/css/Resume.css" asp-append-version="true" />
}

<div class="container mt-5 mb-5" >
<div class="d-flex justify-content-between align-items-center mb-4 no-print" >
<a asp-action="Home" class="btn btn-outline-secondary" >
<i class="bi bi-arrow-left" > </i > Tillbaka
</a >
<button onclick="window.print()" class="btn btn-primary" >
<i class="bi bi-printer" > </i > Spara som PDF
</button >
</div >

<div class="resume-paper" >
@Html.Raw(Model.HtmlContent)
</div >
</div >
